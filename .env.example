## Base defaults used when per-agent values are empty.
# Per-agent overrides: MAIN_, PHILOSOPHER_, SUB_, FUNCTION_CALL_.
# Example: PHILOSOPHER_OPENAI_BASE_URL overrides OPENAI_BASE_URL.
# Inheritance order (when values are empty):
# MAIN_* -> base
# PHILOSOPHER_* -> MAIN_* -> base  # Inherits MAIN_* for non-temperature fields; PHILOSOPHER_MODEL_TEMPERATURE is per-agent only
# SUB_* -> MAIN_* -> base  # Inherits MAIN_* for non-temperature fields; SUB_MODEL_TEMPERATURE is per-agent only
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_NAME=
MODEL_TEMPERATURE=0.2

MAIN_OPENAI_BASE_URL=
MAIN_OPENAI_API_KEY=
MAIN_MODEL_NAME=
MAIN_MODEL_TEMPERATURE=0.5

PHILOSOPHER_OPENAI_BASE_URL=
PHILOSOPHER_OPENAI_API_KEY=
PHILOSOPHER_MODEL_NAME=
PHILOSOPHER_MODEL_TEMPERATURE=0.2

SUB_OPENAI_BASE_URL=
SUB_OPENAI_API_KEY=
SUB_MODEL_NAME=
SUB_MODEL_TEMPERATURE=1.0
