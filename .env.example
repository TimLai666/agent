## Base defaults used when per-agent values are empty.
# Per-agent overrides: MAIN_, CO_, PHILOSOPHER_, SUB_, FUNCTION_CALL_.
# Example: CO_OPENAI_BASE_URL overrides OPENAI_BASE_URL for the co-agent.
# Philosopher inherits CO_ when PHILOSOPHER_ values are empty.
# Function-call agent inherits SUB_ when FUNCTION_CALL_ values are empty.
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_NAME=
MODEL_TEMPERATURE=0.2

MAIN_OPENAI_BASE_URL=
MAIN_OPENAI_API_KEY=
MAIN_MODEL_NAME=
MAIN_MODEL_TEMPERATURE=

CO_OPENAI_BASE_URL=
CO_OPENAI_API_KEY=
CO_MODEL_NAME=
CO_MODEL_TEMPERATURE=

PHILOSOPHER_OPENAI_BASE_URL=
PHILOSOPHER_OPENAI_API_KEY=
PHILOSOPHER_MODEL_NAME=
PHILOSOPHER_MODEL_TEMPERATURE=

SUB_OPENAI_BASE_URL=
SUB_OPENAI_API_KEY=
SUB_MODEL_NAME=
SUB_MODEL_TEMPERATURE=

FUNCTION_CALL_OPENAI_BASE_URL=
FUNCTION_CALL_OPENAI_API_KEY=
FUNCTION_CALL_MODEL_NAME=
FUNCTION_CALL_MODEL_TEMPERATURE=
